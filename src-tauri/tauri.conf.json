{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AutoKlipper",
  "mainBinaryName": "AutoKlipper",
  "version": "0.2.0",
  "identifier": "app.clipit.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AutoKlipper",
        "width": 1400,
        "height": 880,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "backgroundColor": "#070b16"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https:; media-src 'self' asset: http://asset.localhost blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'",
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "maeldotdev",
    "copyright": "Copyright (c) 2026 maeldotdev. MIT licence.",
    "category": "Video",
    "shortDescription": "Local AI video clipping studio",
    "licenseFile": "../legal/INSTALLER_LICENSE.txt",
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../public/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4RkY3QjJFRkNEOTRCOTAKUldTUVM5bjhMbnYvcUJlaFVVTDgya05wSk9MWnNnTFNuVXBWVU9FbUZHRWxmUE12dktlTnRoUWEK",
      "endpoints": [
        "https://github.com/maeldotdev/AutoKlipper/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}