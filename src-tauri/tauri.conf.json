{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AutoKlipper",
  "mainBinaryName": "AutoKlipper",
  "version": "0.1.0",
  "identifier": "app.clipit.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AutoKlipper",
        "width": 1400,
        "height": 880,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "backgroundColor": "#070b16"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "maeldotdev",
    "copyright": "Copyright (c) 2026 maeldotdev. MIT licence.",
    "category": "Video",
    "shortDescription": "Local AI video clipping studio",
    "licenseFile": "../legal/INSTALLER_LICENSE.txt",
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../public/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}